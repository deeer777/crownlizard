{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crownlizard-pvp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "DUEL_ROOMS", "class_name": "DuelRoom" }
    ]
  },
  "exports": {
    "DuelRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
